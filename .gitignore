# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local operator state and secrets — NEVER commit these.
# (Tracked defaults live in config/*.example.toml; real local config does not.)
config/local.toml
config/secrets.toml
config/*.local.toml
secrets/
*.secret
*.key
*.pem

# Generated runtime state (the dev checkout should never carry runtime artifacts)
run/
.run/
state/
logs/
*.log

# Editor
.idea/
.vscode/
*.swp
.claude/

# coverage data — a local artifact, never committed
.coverage
.coverage.*

# Shipped browser bundles are PACKAGE DATA, not build output. The generic rules above
# (dist/, build/, *.log, *.key …) match paths INSIDE a vendored bundle — `dist/` alone hid
# two files of MeshChat's rnode-flasher, so a fresh clone built an incomplete UI while the
# developer's tree looked complete. Nothing under these trees is ever generated here.
!lhpc/data/*-dist/
!lhpc/data/*-dist/**
