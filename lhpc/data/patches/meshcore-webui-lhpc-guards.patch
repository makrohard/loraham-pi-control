+    async def _acquire_slot_lease(self, lock_path: str):
+        """Acquire the Companion-slot transition lease, YIELDING while a live meshcore-cli holds
+        it. Returns an open fd that HOLDS the flock — the caller MUST release it once its own
+        connection is established — or None if no lock is configured or we are stopping.
+
+        Holding this lease ACROSS _connect_once() makes the WebUI check-and-connect atomic: a CLI
+        (which blocks for this same lease) cannot connect in the gap and then be evicted by our
+        connect. A stale lock pathname with no live owner is acquirable, so a CLI crash/reboot
+        never wedges the WebUI.
+        """
+        if not lock_path:
+            return None
+        try:
+            fd = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o644)
+        except OSError:
+            return None
+        announced = False
+        while not self._stopping.is_set():
+            try:
+                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                return fd  # HELD across the connect; caller releases once connected
+            except OSError:
+                if not announced:
+                    log.info("meshcore-cli owns the Companion slot; WebUI yielding")
+                    announced = True
+                with contextlib.suppress(asyncio.TimeoutError):
+                    await asyncio.wait_for(self._stopping.wait(), timeout=1.0)
+        os.close(fd)
+        return None
