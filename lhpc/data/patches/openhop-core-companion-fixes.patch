diff --git a/src/openhop_core/companion/companion_radio.py b/src/openhop_core/companion/companion_radio.py
index 8011ddb..efb9016 100644
--- a/src/openhop_core/companion/companion_radio.py
+++ b/src/openhop_core/companion/companion_radio.py
@@ -391,6 +391,21 @@ class CompanionRadio(CompanionBase):
             radio_stats["last_rssi"] = self._radio.get_last_rssi()
         if hasattr(self._radio, "get_last_snr"):
             radio_stats["last_snr"] = self._radio.get_last_snr()
+        # Radio backends (SX1262, TCP, LoRaHAM daemon, …) measure the channel
+        # noise floor, but STATS_TYPE_RADIO left it at the 0 default. Mirror the
+        # last_rssi/last_snr surfacing above when it is a cheap cached accessor.
+        # get_stats() can run on the event loop (no async stats_getter), so skip
+        # a backend whose sync get_noise_floor() does blocking modem I/O — those
+        # advertise a get_noise_floor_async() worker-thread variant (KISS) and
+        # would stall the loop here. get_noise_floor() returns None when it has
+        # no fresh reading (uninitialised, or a TX in progress); only surface a
+        # real measurement.
+        if hasattr(self._radio, "get_noise_floor") and not hasattr(
+            self._radio, "get_noise_floor_async"
+        ):
+            noise_floor = self._radio.get_noise_floor()
+            if noise_floor is not None:
+                radio_stats["noise_floor"] = noise_floor
         return radio_stats
 
