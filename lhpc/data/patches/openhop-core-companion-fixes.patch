diff --git a/tests/test_companion_radio.py b/tests/test_companion_radio.py
index aea077a..c8bc140 100644
--- a/tests/test_companion_radio.py
+++ b/tests/test_companion_radio.py
@@ -489,6 +489,57 @@ class TestCompanionRadioStats:
         assert "direct_rx" in tot
         assert "tx_errors" in tot
 
+    def test_get_stats_radio_surfaces_rssi_and_snr(self):
+        # STATS_TYPE_RADIO (1) reports the radio's live RSSI/SNR.
+        comp = CompanionRadio(MockRadio(), LocalIdentity())
+        radio_stats = comp.get_stats(1)
+        assert radio_stats["last_rssi"] == -70
+        assert radio_stats["last_snr"] == 5
+
+    def test_get_stats_radio_surfaces_measured_noise_floor(self):
+        # A backend that exposes a cheap, non-blocking get_noise_floor() (SX1262, the TCP radio,
+        # and the LoRaHAM daemon adapter) has it surfaced into STATS_TYPE_RADIO instead of
+        # defaulting to 0. Backends whose sync getter does blocking I/O (KISS) are excluded — see
+        # test_get_stats_radio_skips_blocking_noise_floor.
+        class NoiseRadio(MockRadio):
+            def get_noise_floor(self):
+                return -119.5
+
+        radio_stats = CompanionRadio(NoiseRadio(), LocalIdentity()).get_stats(1)
+        assert radio_stats["noise_floor"] == -119.5
+
+    def test_get_stats_radio_omits_noise_floor_when_unavailable(self):
+        # get_noise_floor() returns None with no fresh reading (uninitialised,
+        # or TX in progress); the key is omitted so the frame keeps its 0
+        # default rather than packing a bogus value.
+        class NoNoiseYetRadio(MockRadio):
+            def get_noise_floor(self):
+                return None
+
+        radio_stats = CompanionRadio(NoNoiseYetRadio(), LocalIdentity()).get_stats(1)
+        assert "noise_floor" not in radio_stats
+
+    def test_get_stats_radio_omits_noise_floor_when_unsupported(self):
+        # A radio without get_noise_floor() (the base MockRadio) never gains
+        # the key — the hasattr guard leaves the stats untouched.
+        radio_stats = CompanionRadio(MockRadio(), LocalIdentity()).get_stats(1)
+        assert "noise_floor" not in radio_stats
+
+    def test_get_stats_radio_skips_blocking_noise_floor(self):
+        # A backend whose sync get_noise_floor() does blocking modem I/O
+        # advertises a get_noise_floor_async() variant (KISS). get_stats() can
+        # run on the event loop, so the sync getter must NOT be called here —
+        # the stats keep the 0 default rather than stalling the loop.
+        class BlockingNoiseRadio(MockRadio):
+            def get_noise_floor(self):
+                raise AssertionError("blocking get_noise_floor called on the event loop")
+
+            async def get_noise_floor_async(self):
+                return -110.0
+
+        radio_stats = CompanionRadio(BlockingNoiseRadio(), LocalIdentity()).get_stats(1)
+        assert "noise_floor" not in radio_stats
+
 
