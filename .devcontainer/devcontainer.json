{
    "name": "LHPC Test Lab",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "lhpclab",
    "containerEnv": {
        "LHPC_SYSTEM_PROVIDER": "lhpc_testlab.provider:build",
        "LHPC_TESTLAB": "1",
        "LHPC_BOOT_ID_FILE": "/home/lhpclab/loraham-pi-control/state/testlab/host/boot_id",
        "LHPC_FW_PATH_PREFIX": "/home/lhpclab/loraham-pi-control/state/testlab/host",
        "LHPC_ACCEPTANCE": "1",
        "LHPC_BROWSER": "1",
        "DISPLAY": ":99",
        "LHPC_QEMU_MIN_FREE_INODES": "0"
    },
    "onCreateCommand": "bash .devcontainer/oncreate.sh",
    "postStartCommand": "bash .devcontainer/start.sh",
    "forwardPorts": [
        8770,
        8080,
        18083,
        9080,
        9443,
        8444,
        8445,
        8447,
        8448,
        8577,
        8579,
        8580,
        8582,
        8446,
        8449,
        8450,
        8451,
        5133,
        8921
    ],
    "portsAttributes": {
        "8770": {
            "label": "LHPC console",
            "visibility": "private",
            "onAutoForward": "openBrowser",
            "requireLocalPort": false
        },
        "8080": {
            "label": "graywolf web UI",
            "visibility": "private"
        },
        "18083": {
            "label": "meshcom web UI",
            "visibility": "private"
        },
        "9080": {
            "label": "meshtastic web UI",
            "visibility": "private",
            "onAutoForward": "notify"
        },
        "9443": {
            "label": "meshtastic web UI (direct https, self-signed)",
            "visibility": "private",
            "protocol": "https"
        },
        "8444": {
            "label": "stackweb proxy graywolf@r1 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8445": {
            "label": "stackweb proxy meshcom@r1 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8447": {
            "label": "stackweb proxy meshtastic@r1 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8448": {
            "label": "stackweb proxy reticulum@r1 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8577": {
            "label": "stackweb proxy graywolf@r2 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8579": {
            "label": "stackweb proxy meshcore@r2 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8580": {
            "label": "stackweb proxy meshtastic@r2 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8582": {
            "label": "stackweb proxy meshcore-meshcore-node@r2 (8444 + kind + 133 x (n - 1))",
            "visibility": "private"
        },
        "8446": {
            "label": "stackweb proxy (a page saved on the old positional default)",
            "visibility": "private"
        },
        "8449": {
            "label": "stackweb proxy (a page saved on the old positional default)",
            "visibility": "private"
        },
        "8450": {
            "label": "stackweb proxy (a page saved on the old positional default)",
            "visibility": "private"
        },
        "8451": {
            "label": "stackweb proxy (a page saved on the old positional default)",
            "visibility": "private"
        },
        "5133": {
            "label": "meshcore@r2 (868, the lab list's r2: 5000 + 133)",
            "visibility": "private"
        },
        "8921": {
            "label": "meshcore@r2 web UI (8788 + 133)",
            "visibility": "private"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ]
        }
    },
    "postAttachCommand": "bash .devcontainer/start.sh"
}
