# LoRaHAM Pi Control nginx TLS front-end — CANONICAL managed unit (generated; do not hand-edit).
# Rootless USER service: terminates HTTPS/mTLS on the configured high port (default 8443) and
# reverse-proxies to the Waitress unix socket. LHPC GENERATES + VALIDATES the config; runtime
# reloads use `nginx -s reload` (never systemctl). Install/enable/start happen in OPERATOR
# context only (installer / --repair-integration / CLI) — the web process never starts it.
[Unit]
Description=LoRaHAM Pi Control nginx TLS front-end
Documentation=file://%h/loraham-pi-control/src/loraham-pi-control/docs/webserver.md
After=network-online.target lhpc-web.service
Wants=network-online.target lhpc-web.service
# Do not run until LHPC has generated a proxy config (webserver apply/init writes it).
ConditionPathExists=%h/loraham-pi-control/config/nginx/lhpc.conf

[Service]
Type=forking
Environment=LHPC_RUNTIME_ROOT=%h/loraham-pi-control
PIDFile=%h/loraham-pi-control/state/run/nginx.pid
ExecStartPre=/usr/sbin/nginx -t -c %h/loraham-pi-control/config/nginx/lhpc.conf
# Managed-firewall boot gate: when the firewall is installed and the desired config exposes a
# remote listener, this refuses to bind that listener ahead of a verified current-boot firewall
# receipt — regenerating the active config LOOPBACK-ONLY instead (recovery via SSH tunnel; the
# desired remote intent in local.toml is untouched and never marked applied). No-op when the
# firewall is absent or nothing remote is desired. Always exits 0 so nginx still starts.
ExecStartPre=%h/loraham-pi-control/venv/lhpc/bin/lhpc webserver --firewall-boot-gate
ExecStart=/usr/sbin/nginx -c %h/loraham-pi-control/config/nginx/lhpc.conf
ExecReload=/usr/sbin/nginx -s reload -c %h/loraham-pi-control/config/nginx/lhpc.conf
ExecStop=/usr/sbin/nginx -s quit -c %h/loraham-pi-control/config/nginx/lhpc.conf
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lhpc-nginx
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/loraham-pi-control /tmp
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
