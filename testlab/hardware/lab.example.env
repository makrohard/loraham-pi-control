# lab.example.env: every key rf-proof.sh reads, with placeholders. Copy it to lab.local.env (git-ignored) and fill in your
# lab. No secrets here or there: the box passwords and the MeshCore PIN come on stdin (rf-proof.sh refuses a file that sets a
# variable with a name part PASS, PASSWD, PASSWORD, PW, PIN or SECRET). The DRY_* keys are the dry run's simulated bench; live ignores them.
# The file is read as data, never run: one KEY=VALUE per entry, only the keys below; a value bare (one word), '...' (may span
# lines) or "..." (one line, no $ ` \ "). Any other line stops the run.
# A key set in the environment wins over this file (the tests override the dry inventory that way).

# The boxes (B = H, Z): the address (no default), the login (default lhpc), the runtime path on the box (default
# ~/loraham-pi-control, relative to that login's home). An empty BOX_<B>_HOST in a dry run = that box is absent.
BOX_H_HOST=box-h.example
BOX_H_USER=lhpc
BOX_H_RUNTIME='~/loraham-pi-control'
BOX_Z_HOST=zero.example
BOX_Z_USER=lhpc
BOX_Z_RUNTIME='~/loraham-pi-control'

# The radio keys of the ROWS table: "<box> <model> <band> [serial=<s>|port=<p>]". R0 resolves each to exactly one enabled radio
# of that box's hardware list; none = NOT RUN "absent: radio <KEY>", two or more = NOT RUN "ambiguous: radio <KEY> (<n> match)".
RADIO_H433="H loraham 433"
RADIO_H868="H loraham 868"
RADIO_HSTK="H ch341-rfm98pw-433 433 serial=STICK433A"
RADIO_HMS="H meshstick-1262 868 serial=MSTICK01"
RADIO_HPINE="H pinedio-usb-1262 868 port=1-1"
RADIO_Z433="Z loraham 433"
RADIO_Z868="Z loraham 868"

# The PC peers: "<kind> <by-id name | BLE address> <hub> [serial_unique=false]". An empty or unset key = that peer is absent.
# The rnode peer also names its RNS shared instance: instance=<name> port=<n> control=<n> (no defaults; 1..65535, different).
PEER_tdeck="meshcom usb-Example_TDeck_MeshCom-if00 hubA"
PEER_tracker="aprs usb-Example_Tracker_APRS-if00 hubB"
PEER_g2="meshtastic usb-Example_Station_G2-if00 hubB"
PEER_tdpro="meshcore-ble 00:11:22:33:44:55 -"
PEER_rnode="rnode usb-Example_RNode_CP2102-if00-port0 hubA serial_unique=false instance=lhpc-rf-host port=37438 control=37439"

# The operator's callsign WITHOUT an SSID. Never in an argv, a command or the evidence: it is redacted from every capture.
OPERATOR_CALL=N0CALL

# The PC side: the peer venvs, the shared rnsd config directory, the peer lock, the evidence root (under /home, never /tmp).
VENV_MT='~/.venv-meshtastic'
VENV_RNS='~/.venv-rns'
RNS_CONFIG='~/rns-host'
PEER_LOCK='~/rf-proof-peer.lock'
EVD_ROOT='~/rf-proof-evidence'
# fw-boxproof.sh only: a PEM client cert + unencrypted key (mode 600) for the console's remote-auth from the LAN; empty = none
LAN_CERT=

# ---- the dry inventory (dry only) ----------------------------------------------------------------------------------------
# Each box's hardware list in the form R0 reads (STATE, then one ROW per radio: rid model band enabled serial= port= hp=).
DRY_RADIOS_H='STATE valid
ROW r1 loraham 433 True serial= port= hp=None
ROW r2 loraham 868 True serial= port= hp=None
ROW r3 ch341-rfm98pw-433 433 True serial=STICK433A port=1-2 hp=False
ROW r4 pinedio-usb-1262 868 True serial= port=1-1 hp=False
ROW r5 meshstick-1262 868 True serial=MSTICK01 port=1-3 hp=False'
DRY_RADIOS_Z='STATE valid
ROW r1 loraham 433 True serial= port= hp=None
ROW r2 loraham 868 True serial= port= hp=None'
# The PC's /dev/serial/by-id names and the reachable BLE addresses.
DRY_BYID='usb-Example_TDeck_MeshCom-if00 usb-Example_Tracker_APRS-if00 usb-Example_Station_G2-if00 usb-Example_RNode_CP2102-if00-port0'
DRY_BLE='00:11:22:33:44:55'
# A radio's STATUS line: DRY_STATUS_<box>_<rid>. Unset = a valid line with FREQ/SF of the radio's band and POWER=10.
